{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "osrs-llm-gm-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-08-21",
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "WORKERS_AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "ALLOWED_ORIGIN": "https://YOUR_GITHUB_USER.github.io"
  }
}
